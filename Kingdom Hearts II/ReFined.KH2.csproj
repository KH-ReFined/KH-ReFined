<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<LangVersion>latest</LangVersion>
	<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
	<UseWindowsForms>true</UseWindowsForms>
	<BaseOutputPath>..\..\Build\Kingdom Hearts II</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\prologue_flags.byte" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\prologue_flags.byte" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Octokit" Version="14.0.0" />
    <PackageReference Include="System.IO.Compression" Version="4.3.0" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Third Party\BinarySharp\BinarySharp.csproj" />
    <ProjectReference Include="..\..\Third Party\DiscordRPC\DiscordRPC.csproj" />
    <ProjectReference Include="..\..\Third Party\KH2-FML\KH2-FML.csproj" />
  </ItemGroup>

</Project>
